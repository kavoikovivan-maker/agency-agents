# Copy to platform/.env and adjust as needed.
# The app boots and works fully with a deterministic mock provider
# even if none of these are set — MODEL_PROVIDER defaults to "mock".

# --- Model provider selection ---
# mock | openai | groq
MODEL_PROVIDER=mock

# --- OpenAI-compatible provider (used when MODEL_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Groq-compatible provider (used when MODEL_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- Security ---
# Leave empty for explicit single-user local mode (no login required).
# Set a password to require /api/auth/login before using the API.
APP_PASSWORD=

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Uploads ---
MAX_UPLOAD_MB=20

# --- Orchestrator ---
MAX_AGENTS_PER_TASK=6

# --- Provider resilience ---
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2
